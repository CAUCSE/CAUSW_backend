# ==========================================
# 환경변수 템플릿 (.env.example)
# 이 파일을 복사하여 '.env'로 이름을 바꾸고 실제 값을 채워주세요.
# ==========================================

# [Profile]
SPRING_PROFILES_ACTIVE=

# [Datasource]
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# [JWT]
JWT_SECRET_KEY=

# [Redis]
REDIS_HOST=
REDIS_PORT=

# [Mail]
MAIL_USERNAME=
MAIL_PASSWORD=

# [Password]
PASSWORD_PREFIX=

# [OAuth2 - Google]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OAuth2 - Kakao]
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# [OAuth2 - Apple]
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# [OAuth2 - Apple IOS]
APPLE_IOS_CLIENT_ID=
APPLE_IOS_CLIENT_SECRET=

# [AWS]
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# [AWS SES Email Campaign]
# 운영 환경에서는 AWS credential 대신 EC2 Instance Profile을 사용합니다.
EMAIL_CAMPAIGN_ENABLED=false
EMAIL_CAMPAIGN_SES_REGION=ap-northeast-2
EMAIL_CAMPAIGN_FROM_ADDRESS=
EMAIL_CAMPAIGN_REPLY_TO_ADDRESS=
EMAIL_CAMPAIGN_BATCH_SIZE=50
EMAIL_CAMPAIGN_MAX_CONCURRENCY=5
EMAIL_CAMPAIGN_MAX_SEND_RATE=1.0
EMAIL_CAMPAIGN_MAX_ATTEMPTS=3
EMAIL_CAMPAIGN_INITIAL_BACKOFF_SECONDS=30
EMAIL_CAMPAIGN_CLAIM_TIMEOUT_SECONDS=300
EMAIL_CAMPAIGN_RECOVERY_INTERVAL_MS=30000

# [Firebase (FCM)]
FCM_FIREBASE_KEY_BASE64=
FCM_PROJECT_ID=

# [CORS]
CORS_ALLOWED_ORIGINS=

# [External API]
HOLIDAY_API_SERVICE_KEY=

# [Oauth - Refresh Token]
OAUTH_REFRESH_TOKEN_AES_KEY_BASE64=

# [Swagger]
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# [Custom Hash key]
CUSTOM_HASH_SALT=

# [Kakao admin key]
KAKAO_ADMIN_KEY=
